# AuditPilot V2 环境配置模板
# 复制为 .env 后填入真实 API Key；留空时系统自动启用内置离线演示模式（仍运行真实本地 SQL/RAG/脱敏引擎）

# 主模型（OpenAI 兼容接口，例如 DeepSeek / 通义千问 / 豆包）
PRIMARY_LLM_BASE_URL=https://api.deepseek.com/v1
PRIMARY_LLM_API_KEY=
PRIMARY_LLM_MODEL=deepseek-chat

# 备用降级模型（主模型超时/报错或开启故障演练时自动切换）
BACKUP_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BACKUP_LLM_API_KEY=
BACKUP_LLM_MODEL=qwen-plus

# 超时与缓存配置
LLM_TIMEOUT_SECONDS=20
QUERY_CACHE_TTL_SECONDS=300
SIMULATE_PRIMARY_FAILURE=false
